{
  "name": "archivar-poc",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "clean": "rm -rf ./dist && rm -rf ./.astro && rm -rf ./node_modules/.vite",
    "dev": "ENV_FILE=.env.local astro dev --host --port 8801",
    "prestart": "pnpm build",
    "start": "ENV_FILE=.env.local HOST=0.0.0.0 PORT=8801 node dist/server/entry.mjs --host",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test": "npx vitest run",
    "stop": "sh -c 'pids=$(lsof -tiTCP:8801 -sTCP:LISTEN 2>/dev/null || true); if [ -z \"$pids\" ] && command -v ss >/dev/null 2>&1; then pids=$(ss -ltnp \"( sport = :8801 )\" 2>/dev/null | grep -o \"pid=[0-9]\\+\" | cut -d= -f2 | sort -u | xargs 2>/dev/null || true); fi; if [ -z \"$pids\" ] && command -v fuser >/dev/null 2>&1; then pids=$(fuser -n tcp 8801 2>/dev/null | xargs 2>/dev/null || true); fi; if [ -z \"$pids\" ]; then echo \"No process listening on port 8801\"; exit 0; fi; kill $pids; echo \"Stopped process on port 8801: $pids\"'",
    "cli": "tsx src/cli.ts",
    "cli:list": "tsx src/cli.ts list",
    "cli:workflows": "tsx src/cli.ts workflows",
    "cli:analyze": "tsx src/cli.ts analyze"
  },
  "dependencies": {
    "@astrojs/node": "^11.0.2",
    "@byjohann/toon": "^0.6.0",
    "@swc/wasm": "^1.15.43",
    "@tailwindcss/vite": "^4.1.4",
    "@types/uikit": "^3.14.5",
    "astro": "^7.0.6",
    "browserslist": "^4.28.4",
    "defuss": "^3.4.9",
    "defuss-astro": "^1.8.0",
    "defuss-db": "^1.1.4",
    "defuss-dson": "^1.1.2",
    "defuss-env": "^1.0.3",
    "defuss-jwt": "^1.0.2",
    "defuss-rpc": "^1.6.2",
    "defuss-transval": "^1.3.1",
    "defuss-vite": "^1.2.1",
    "docx": "^9.7.1",
    "fast-glob": "^3.3.3",
    "franken-ui": "2.1.0-next.4",
    "katex": "^0.19.0",
    "lightningcss": "^1.30.1",
    "marked": "^18.0.5",
    "mongodb": "^6.19.0",
    "sharp": "^0.34.3",
    "tailwindcss": "^4.1.4",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.19.0",
    "uikit": "^3.23.6",
    "undici": "^8.5.0",
    "vite": "^6.3.5",
    "yup": "^1.7.1"
  },
  "packageManager": "pnpm@9.13.2",
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}