# Host port the container publishes on. 8802 keeps it clear of the dev server (:8801).
ARCHIVAR_PORT=8802
# ============================================================================
# .env — CONTAINER variant (copy to `.env`; consumed by config.sh / start.sh
# and injected into the archivar container via `docker run --env-file`).
# The dev server does NOT read this file — it reads `.env.local` instead
# (see .env.local.example).
# ============================================================================

# Runtime model credentials (endpoint + apiKey) loaded by getModel(),
# matched by model name. Defaults target the S configuration
# (gemma-4-E4B VLM on :9031, Qwen3-ASR-0.6B on :8932); the M/L endpoints are
# only needed when running the default-analysis / default-analysis-35b
# workflows. Keep the JSON on ONE line.
# Endpoints point at the Docker HOST via host.docker.internal — start.sh maps
# that name to the host gateway automatically (--add-host ...:host-gateway).
# When the model servers run elsewhere, adjust the hosts (see EXTRA_HOSTS in
# config.sh) or the endpoints here.
MODEL_CONFIG='[{"name":"Qwen3.8-27B-FP8","endpoint":"http://host.docker.internal:8920","apiKey":"your-api-key"},{"name":"Qwen3.6-35B-A3B-GPTQ-Int4","endpoint":"http://host.docker.internal:8931","apiKey":"your-api-key"},{"name":"qwen-asr-0.6b","endpoint":"http://host.docker.internal:8932","apiKey":"your-api-key"},{"name":"gemma4-e4b-qat-w4a16","endpoint":"http://host.docker.internal:9031","apiKey":"your-api-key"},{"name":"parakeet-primeline-de","endpoint":"http://host.docker.internal:8999/v1/audio/transcriptions","apiKey":"your-api-key"},{"name":"Whisper3-Large-Turbo-DE","endpoint":"http://host.docker.internal:8998/v1/","apiKey":"your-api-key"}]'

# API key for the CLI/REST guard (matches the code default).
API_KEY=your-api-key

# Dashboard login (change for real deployments).
AUTH_USERNAME=user@archivar.local
AUTH_PASSWORD=login

# Optional HTTP origin that serves the sample files to the dashboard player.
# Empty = the archivar container serves them itself via the
# /app/public/sample_data symlink (BASE_PATH then follows the mount layout).
SAMPLE_DATA_SERVER="" # e.g. http://127.0.0.1:8090 when sample-data-serve runs
SAMPLE_DATA_BASE_PATH=sample_data/archivar

# Data directory layout: the media tree is mounted into the container at the
# FIXED point /sample_data/archivar (start.sh maps the host dir there), and
# SAMPLE_DATA_SUBDIR encodes that container-visible layout. Nothing here is
# host-specific: host paths are derived from the scripts' own location
# (config.sh resolves DATA_DIR/TOOLS_DIR relative to the checkout).
SAMPLE_DATA_SUBDIR=sample_data/archivar

# Sibling-project tool resolution (segment-scenes, segment-temporal live next
# to this checkout; their run.sh is spawned through the mounted Docker socket).
# Dev/local uses RELATIVE_TOOLS_PATH against the checkout; the container gets
# ABSOLUTE_TOOLS_PATH injected by start.sh (the identically-mounted host path)
# — you do not set ABSOLUTE_TOOLS_PATH yourself.
RELATIVE_TOOLS_PATH=..

# Host-side mount sources for start.sh, resolved relative to the checkout:
# DATA_DIR  -> mounted to /sample_data/archivar (rw) in the container
# TOOLS_DIR -> mounted at its identical host path (rw; tools write out_* next
#              to the media and their `docker run` reaches the host daemon)
ARCHIVAR_DATA_DIR=../sample_data/archivar
ARCHIVAR_TOOLS_DIR=..

# ABSOLUTE_DIR_PREFIX: optional escape hatch, normally left unset. When set,
# src/db/db.ts anchors the cache storage root at
# <ABSOLUTE_DIR_PREFIX>/<SAMPLE_DATA_SUBDIR> instead of deriving it
# (container: /app/../sample_data/archivar == the fixed mount; dev:
# RELATIVE_SAMPLE_DATA_PATH against the checkout). Do NOT put machine-specific
# absolute paths here — a fresh checkout must work without editing them.
