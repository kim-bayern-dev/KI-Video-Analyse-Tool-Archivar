{
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "defuss",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "resolveJsonModule": true,
    "types": ["astro/client"],
    "strict": true,
    "skipLibCheck": true,
    "ignoreDeprecations": "6.0",
    "paths": {
      "@components/*": ["./src/csr/components/*"],
      "@core/*": ["./src/lib/core/*"],
      "@model/*": ["./src/models/*"],
      "@rpc/*": ["./src/rpc/*"],
      "@pages/*": ["./src/pages/*"],
      "@lib/*": ["./src/lib/*"],
      "@db/*": ["./src/db/*"],
      "@layouts/*": ["./src/layouts/*"],
    }
  },
  "include": ["src", "i18n", "test", "astro.config.ts", "vitest.config.ts", ".astro/types.d.ts"]
}
