# ============================================================================
# .env.local — DEV/LOCAL variant (copy to `.env.local`; created by
# `make setup`). Read by the dev server (package.json sets ENV_FILE=.env.local)
# and the vitest suite. The container does NOT use this file — it uses `.env`
# instead (see .env.example).
# ============================================================================

# Runtime model credentials (endpoint + apiKey) loaded by getModel(),
# matched by model name. Defaults target the S configuration
# (gemma-4-E4B VLM on :9031, Qwen3-ASR-0.6B on :8932); the M/L endpoints are
# only needed when running the default-analysis / default-analysis-35b
# workflows. Keep the JSON on ONE line.
# localhost is correct here: the dev server and the model servers all run on
# this machine (127.0.0.1 is only reachable directly inside the GPU server
# network).
MODEL_CONFIG='[{"name":"Qwen3.8-27B-FP8","endpoint":"http://localhost:8920","apiKey":"your-api-key"},{"name":"Qwen3.6-35B-A3B-GPTQ-Int4","endpoint":"http://localhost:8931","apiKey":"your-api-key"},{"name":"qwen-asr-0.6b","endpoint":"http://localhost:8932","apiKey":"your-api-key"},{"name":"gemma4-e4b-qat-w4a16","endpoint":"http://localhost:9031","apiKey":"your-api-key"},{"name":"parakeet-primeline-de","endpoint":"http://localhost:8999/v1/audio/transcriptions","apiKey":"your-api-key"},{"name":"Whisper3-Large-Turbo-DE","endpoint":"http://localhost:8998/v1/","apiKey":"your-api-key"}]'

# API key for the CLI/REST guard (matches the code default).
API_KEY=your-api-key

# Dashboard login (change for real deployments).
AUTH_USERNAME=user@archivar.local
AUTH_PASSWORD=login

# Optional HTTP origin that serves the sample files to the dashboard player
# (the sample-data-serve sibling project serves the sample_data root on :8090,
# so files land under /archivar/... — hence BASE_PATH=archivar).
SAMPLE_DATA_SERVER="http://127.0.0.1:8090"
SAMPLE_DATA_BASE_PATH=archivar

# Data directory: the archivar corpus next to this checkout. Everything is
# relative — a fresh checkout works without editing paths.
SAMPLE_DATA_SUBDIR=sample_data/archivar
RELATIVE_SAMPLE_DATA_PATH=../sample_data/archivar

# Sibling-project tool resolution (segment-scenes, segment-temporal live next
# to this checkout).
RELATIVE_TOOLS_PATH=..
