# for inference hosting
API_KEY=your-api-key

# GPU memory: 94.09/139.8 GiB free → cap utilization so it fits
GPU_MEM_UTIL=0.11

# Override KV_CACHE_BYTES to empty so GPU_MEM_UTIL is used instead of
# vLLM's default --gpu-memory-utilization 0.9
KV_CACHE_BYTES=9G

# for smoke test
OPENAI_BASE_URL=http://localhost:8931/v1
OPENAI_API_KEY=your-api-key