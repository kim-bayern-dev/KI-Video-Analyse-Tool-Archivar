# Copy to .env and adjust; .env is gitignored and loaded by config.sh.

# Directory to serve files from (default: ../sample_data)
DATA_DIR=../sample_data

# Host port to expose the server on (default: 8090; 8080 is used by vespa)
CADDY_PORT=8090

# Docker network name (default: local-cloud)
NET=local-cloud

# Network alias for container-to-container access (default: sample-data-serve)
ALIAS=sample-data-serve

# Extra arguments appended after the image name in `docker run` (default: empty)
EXTRA_ARGS=
